# Frontend Environment Configuration
# Copy this file to .env.local for local development

# Backend API URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Application URL (for self-referential links)
VITE_APP_URL=http://localhost:3000

# Feature Flags
VITE_ENABLE_BLOCKCHAIN=true
VITE_ENABLE_AI=true
VITE_ENABLE_LEGAL_RESEARCH=true

# Demo Mode (for presentation purposes)
VITE_DEMO_MODE=true

# Note: AI, database, blockchain private keys, and Google OAuth secrets are
# configured on the backend only. Never expose provider keys in frontend
# environment variables.
