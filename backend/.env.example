# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Application
APP_NAME=Legal Vault Backend
APP_VERSION=1.0.0

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=30
AI_RATE_LIMIT_MAX_REQUESTS=60
BLOCKCHAIN_RATE_LIMIT_MAX_REQUESTS=60

# PostgreSQL (Prisma)
# Runtime: use a persistent Supabase Session Pooler URL with encoded password and SSL.
# Example host shape: aws-0-region.pooler.supabase.com:5432
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20&sslmode=require

# Migrations/studio: use a direct database URL when IPv6/network supports it, or Supabase direct-compatible URL.
# Keep this separate from pooled runtime configuration.
DIRECT_URL=postgresql://postgres:ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Session HMAC secret (backend only). Must be non-default in production.
# Generate a strong random string for production use
JWT_SECRET=dev-session-secret-change-me-in-production
SESSION_TTL_SECONDS=28800
FRONTEND_URL=http://localhost:3000

# Google OAuth (backend only)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Blockchain Configuration
# For local development with Hardhat:
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# BLOCKCHAIN_CHAIN_ID=31337
# BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# BLOCKCHAIN_CONTRACT_ADDRESS=

# For Ethereum Sepolia testnet (recommended for demo):
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
BLOCKCHAIN_PRIVATE_KEY=your_wallet_private_key_here
BLOCKCHAIN_CONTRACT_ADDRESS=your_deployed_contract_address_here
BLOCKCHAIN_CHAIN_ID=11155111

# For Ethereum Mainnet (production):
# BLOCKCHAIN_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# BLOCKCHAIN_PRIVATE_KEY=your_wallet_private_key_here
# BLOCKCHAIN_CONTRACT_ADDRESS=your_deployed_contract_address_here
# BLOCKCHAIN_CHAIN_ID=1

# Storage
STORAGE_DIR=storage

# AI Configuration (backend only — never expose keys to the frontend)
# Options: mock, openai, gemini
AI_PROVIDER=mock

# OpenAI Configuration (when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini Configuration (when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini will use gemini-2.0-flash by default when selected

# Vector Store Configuration
# Options: memory, postgres
VECTOR_STORE=memory

# AI Performance Settings
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2

# Frontend Configuration (for reference)
# FRONTEND_URL=http://localhost:3000
